# ==============================================================================
# IronSync Local Environment Variables Template
# Copy these into your local .env.local file.
# Replace placeholders with your actual Supabase credentials.
# NEVER commit .env.local to version control.
# ==============================================================================

# 1. Supabase Project URL (From Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://fdduamdeepiqdytqfwmb.supabase.co

# 2. Supabase Anon Public Key (From Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Supabase Service Role Secret Key (Bypasses RLS for server-side member persistence)
# From Supabase Dashboard > Project Settings > API > Project API Keys > "service_role" (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 4. Member Session Encryption Secret (Timing-safe HMAC-SHA256 cookie signing)
# Generate with terminal: openssl rand -base64 32
MEMBER_SESSION_SECRET=your-32-character-session-secret-here

# 5. Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.ironsync.online
