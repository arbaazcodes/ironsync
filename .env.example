# IronSync Production Environment Variables (Placeholders ONLY)
# Configure these in your Vercel Project Settings > Environment Variables.
# NEVER commit real credentials or .env.local to GitHub.

# Supabase Configuration (Obtain from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Member Session Encryption Secret (Generate with: openssl rand -base64 32)
MEMBER_SESSION_SECRET=your-32-character-session-secret-here

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.ironsync.online

# Optional AI Providers for Coach & Image Generation
# If unset, the app uses the deterministic sports science and biomechanics engine.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional Email Notifications (Resend API)
# If unset, notifications are gracefully skipped and logged to audit as email_skipped without failing requests.
RESEND_API_KEY=
GYM_NOTIFY_EMAIL=front-desk@ironsync.online

